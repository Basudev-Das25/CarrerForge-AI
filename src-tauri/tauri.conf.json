{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "CareerForge AI",
  "version": "0.1.0",
  "identifier": "ai.careerforge.app",
  "mainBinaryName": "careerforge-ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CareerForge AI",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:1420 http://127.0.0.1:8000 ws://localhost:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/careerforge-backend"
    ],
    "resources": []
  },
  "plugins": {
    "updater": {
      "pubkey": "MCowBQYDK2VwAyEAwuFySWVcbowdpdUl98NL7Kc1pjA+szeuplso0toks+U=",
      "endpoints": [
        "https://github.com/Basudev-Das25/CarrerForge-AI/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "both"
      }
    },
    "process": {
      "all": true
    }
  }
}
