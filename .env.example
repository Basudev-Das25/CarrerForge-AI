# CareerForge AI - Environment Configuration
# Copy this file to .env and fill in your values

# AI Provider (openai | claude | openrouter | grok | huggingface | ollama)
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenRouter
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Grok (xAI)
GROK_API_KEY=xai-your-key-here
GROK_MODEL=grok-2

# HuggingFace
HUGGINGFACE_API_KEY=hf_your-key-here
HUGGINGFACE_MODEL=meta-llama/Llama-3-70B-Instruct

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Application
APP_NAME=CareerForge AI
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true

# Database
DATABASE_URL=sqlite:///data/careerforge.db
DATABASE_ECHO=false

# LanceDB
LANCEDB_PATH=./vector_store

# Server
API_HOST=127.0.0.1
API_PORT=8000

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/careerforge.log

# Security
ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
